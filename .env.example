# 데이터 저장 방식
#   local-demo (기본): 브라우저 저장소 데모. 외부 키 필요 없음. Vercel 공개 데모가 이 방식.
#   supabase: 로컬 Supabase에 로그인 사용자별로 저장. 먼저 `npm run db:start`.
NEXT_PUBLIC_DATA_SOURCE=local-demo

# supabase 모드에서만 필요. 로컬 값은 `npx supabase status -o env`의 API_URL / ANON_KEY.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (브라우저 번들에 넣지 말 것). 로컬 값은 SERVICE_ROLE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# 개발 전용 테스트 로그인·본인확인 흉내. 로컬 Supabase 주소일 때만 동작하며 운영에서는 켜지 마세요.
# DEV_TEST_LOGIN=1
